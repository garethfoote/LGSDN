+/* Offset the complete middle row to preserve the alternating reading rhythm. */
 @media (min-width: 64rem) {
-	.homepage-feature-row--playbook {
+	.homepage-feature-row--contribute {
 		margin-inline-start: calc(var(--lgsdn-gutter) - var(--homepage-feature-inset));
 		margin-inline-end: calc(var(--homepage-feature-inset) - var(--lgsdn-gutter));
 	}
 }
+
+/* Join-panel experiment: legacy feature-row rules retained for reversal. */
+.homepage-participation {
+ width: min(100%, 82rem); margin-inline: auto;
+ padding: 0 var(--lgsdn-gutter) var(--wp--preset--spacing--50);
+}
+.homepage-join {
+ display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
+ grid-template-areas: "image copy"; background: color-mix(in srgb, var(--lgsdn-hero-graphic-accent) 25%, var(--canvas));
+}
+.homepage-join__media { grid-area: image; min-width: 0; position: relative; overflow: hidden; }
+.homepage-join__image { display: block; width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; }
+.homepage-participation__copy { display: flex; flex-direction: column; align-items: start; }
+.homepage-join > .homepage-participation__copy {
+ grid-area: copy; align-self: center;
+ padding: clamp(var(--wp--preset--spacing--40), 3vw, var(--wp--preset--spacing--60));
+}
+.homepage-participation h2 {
+ font-family: var(--heading-font); font-size: var(--wp--preset--font-size--x-large); font-weight: 400; line-height: 1.2;
+}
+.homepage-participation p { margin-block: var(--wp--preset--spacing--40) var(--wp--preset--spacing--50); line-height: 1.5; }
+.homepage-join p { font-size: var(--wp--preset--font-size--body-x-large); }
+@media (max-width: 63.999rem) {
+ .homepage-join p { font-size: var(--wp--preset--font-size--card-title); }
+ .homepage-join h2 { font-size: var(--wp--preset--font-size--body-x-large); }
+}
+@media (max-width: 47.999rem) {
+ .homepage-join { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); grid-template-areas: "image" "copy"; }
+ .homepage-join > .homepage-participation__copy { align-self: start; }
+ .homepage-join__media { aspect-ratio: 16 / 9; }
+}
+
+/* Upcoming event / join spotlight: manually controlled, without auto-advance. */
+.homepage-spotlight__slides { display: grid; gap: var(--wp--preset--spacing--40); }
+.homepage-spotlight__viewport { padding-inline: var(--wp--preset--spacing--20); margin-inline: calc(-1 * var(--wp--preset--spacing--20)); }
+.is-enhanced .homepage-spotlight__viewport { overflow: hidden; }
+.is-enhanced .homepage-spotlight__slides {
+ grid-auto-flow: column; grid-auto-columns: 100%;
+ --homepage-spotlight-gap: var(--wp--preset--spacing--40);
+ gap: var(--homepage-spotlight-gap);
+ transform: translateX(calc(var(--spotlight-index, 0) * (-100% - var(--homepage-spotlight-gap)) + var(--spotlight-drag, 0px)));
+ transition: transform 420ms ease;
+}
+@media (prefers-reduced-motion: reduce) { .is-enhanced .homepage-spotlight__slides { transition: none; } }
+.is-enhanced .homepage-spotlight__slide { min-width: 0; }
+
+.homepage-spotlight__event { --lgsdn-events-title-size: var(--wp--preset--font-size--x-large); }
+.homepage-spotlight__eyebrow { margin-bottom: var(--wp--preset--spacing--30); font-family: var(--wp--preset--font-family--body); font-size: var(--wp--preset--font-size--small); font-weight: 300; line-height: 1.2; text-transform: uppercase; }
+.homepage-spotlight__event .lgsdn-events__title { font-size: var(--lgsdn-events-title-size); }
+.homepage-spotlight__event .lgsdn-events__link { margin-top: var(--wp--preset--spacing--50); }
+.homepage-spotlight__event .homepage-join__media { overflow: visible; }
+.homepage-spotlight__event .lgsdn-events__meta { margin-top: var(--wp--preset--spacing--30); }
+.homepage-spotlight__fallback { display: grid; place-items: center; background: var(--wp--preset--color--mist); }
+.homepage-spotlight__contour { width: min(65%, 16rem); height: auto; }
+.homepage-spotlight__controls { display: flex; justify-content: center; gap: 0.5rem; margin-top: var(--wp--preset--spacing--30); }
+.homepage-spotlight__controls[hidden] { display: none; }
+@media (max-width: 63.999rem) {
+ .homepage-spotlight__event { --lgsdn-events-title-size: var(--wp--preset--font-size--body-x-large); }
+}
+
+.homepage-spotlight__event .homepage-spotlight__summary { margin-block: var(--wp--preset--spacing--30) 0; font-size: var(--wp--preset--font-size--card-title); line-height: 1.5; }
+
+.is-enhanced .homepage-spotlight__viewport { touch-action: pan-y pinch-zoom; cursor: grab; }
+.is-dragging .homepage-spotlight__slides { transition: none; user-select: none; }
+.is-dragging .homepage-spotlight__viewport { cursor: grabbing; }
+
+.homepage-spotlight__eyebrow { padding: var(--wp--preset--spacing--10) var(--wp--preset--spacing--20); border-radius: var(--wp--preset--spacing--10); background: var(--wp--preset--color--ink); color: var(--wp--preset--color--white); }
