{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lgsdn/events-list",
  "version": "0.1.0",
  "title": "LGSDN events list",
  "category": "theme",
  "description": "Displays events in a shared chronological timeline.",
  "attributes": {
    "showHeading": {
      "type": "boolean",
      "default": true
    },
    "showAll": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "inserter": false
  },
  "render": "file:./render.php"
}
